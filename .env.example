# Exclusivamente proyecto Neon nival_puntos_resenas. Todo es privado, sin NEXT_PUBLIC_.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Secretos distintos, aleatorios, de 32 caracteres como mínimo.
NEON_AUTH_COOKIE_SECRET=
SESSION_SECRET=
# false conserva el backend anterior; true solo tras aplicar y probar foundation-neon.sql.
FOUNDATION_ENABLED=false
# Dominio público exacto autorizado en Trusted Domains de Neon Auth.
APP_URL=http://localhost:3000
# Solo para seed local; NO es necesario cargarlas en Vercel.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_STAFF1_PIN=
SEED_STAFF2_PIN=
# Solo para bootstrap administrativo local. UUID de usuario con correo confirmado.
ADMIN_USER_ID=

# Google Wallet — server only. Either split email/key or complete JSON.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Optional stable, publicly accessible HTTPS origin for logos.
GOOGLE_WALLET_PUBLIC_ORIGIN=

# Evidencias privadas R2 — únicamente servidor; usar buckets distintos por entorno.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_EVIDENCE_BUCKET=

# Cloudflare Turnstile — site key is public; secret stays server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sentry server monitoring. Keep DSN server-only in this project.
SENTRY_DSN=
